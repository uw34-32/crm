# Copy to .env and replace the placeholders. Compose and dev.sh both read .env.
# Local development values only. Never use them in production.

# Database roles. POSTGRES_PASSWORD only takes effect when the volume is first created.
# APP_DB_PASSWORD must stay URL-safe, because dev.sh places it in DATABASE_URL.
POSTGRES_PASSWORD=postgres
APP_DB_PASSWORD=crm_app_local_dev
DATABASE_URL=postgres://crm_app:crm_app_local_dev@localhost:5435/crm?sslmode=disable
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5435/crm?sslmode=disable

# Server
PORT=8085
MIGRATION_TIMEOUT=5m

# Auth
JWT_SECRET=local-development-only-jwt-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
REFRESH_GRACE=10s
AUTH_RATE_LIMIT_PER_MINUTE=30

# HTTP
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,tauri://localhost,http://tauri.localhost
TRUSTED_PROXIES=

# Tests: set both or neither
TEST_DATABASE_URL=postgres://crm_app:crm_app_local_dev@localhost:5435/crm_test?sslmode=disable
TEST_MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5435/crm_test?sslmode=disable
